
import java.util.Random;
import java.util.Scanner;

public class Main {

    static void wypelnijtablice(int[] tablica) {
        Random random = new Random();

        for (int i = 0; i < tablica.length; i++) {
            tablica[i] = random.nextInt(100) + 1;
        }
    }

    static int wyszukaj(int[] tablica, int szukana) {
        int a = tablica.length;
        int[] cos = new int[a + 1];
        for (int i = 0; i < a; i++) {
            cos[i] = tablica[i];
        }
        cos[a] = szukana;
        int i = 0;
        while (cos[i] != szukana) {
            i++;
        }
        if (i == a) {
            return -1;
        }
        return i;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[] tablica = new int[50];
        wypelnijtablice(tablica);
        System.out.print("Podaj liczbe do wyszukania: ");
        int szukana = scanner.nextInt();
        System.out.print("\nTablica: ");
        for (int i = 0; i < tablica.length; i++) {
            System.out.print(tablica[i]);

            if (i < tablica.length - 1) {
                System.out.print(". ");
            }
        }
        int wynik = wyszukaj(tablica, szukana);

        if (wynik == -1) {
            System.out.print("\nNie znaleziono liczby "
                    + szukana + " w tablicy.");
        } else {
            System.out.println("\nLiczba " + szukana
                    + " jest pod indeksem: " + wynik);
        }

        scanner.close();
    }
}
