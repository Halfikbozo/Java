import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Podaj imię: ");
        String imie = sc.next().trim();

        System.out.println("Podaj nazwisko: ");
        String nazwisko = sc.next().trim();

        System.out.println("Podaj email: ");
        String email = sc.next().trim();

        if(!email.contains("@") && !email.contains(".")){
            System.out.println("email wpisany niepoprawnie");
        }

        System.out.println("Podaj hasło: ");
        String haslo = sc.next().trim();

        if(!(haslo.length() >= 8) && !haslo.matches("[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]")){
            System.out.println("Hasło podane niepoprawnie");
        }

        if(nazwisko.isEmpty() || imie.isEmpty() || email.isEmpty() || haslo.isEmpty()){
            System.out.println("Upewnij sie że wszystkie dane są wypełnione");
        }
    }
}
